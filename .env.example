# Copy this file to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables for production.
# None of the NEXT_PUBLIC_ values are secrets (they are visible in the browser).

# Public site address (no trailing slash). Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://everydaytechrepair.com

# Sanity (content dashboard). Find these at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SECRET. Shared with the Sanity webhook so published edits appear on the site
# immediately. Generate a long random string; never commit the real value.
SANITY_REVALIDATE_SECRET=

# Formspree form IDs: the last part of each form's endpoint URL,
# e.g. https://formspree.io/f/abcdwxyz  ->  abcdwxyz
NEXT_PUBLIC_FORMSPREE_REPAIR_ID=
NEXT_PUBLIC_FORMSPREE_SELL_ID=

# Google Analytics 4 measurement ID (starts with G-). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
